# ============================================================
# École Manager — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ----- Django core -----
SECRET_KEY=django-insecure-remplacer-par-une-vraie-cle-secrete
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com

# ----- Base de données -----
# Mettre USE_POSTGRES=True pour activer PostgreSQL (recommandé en production)
USE_POSTGRES=True
DB_NAME=ecole_db
DB_USER=ecole_user
DB_PASSWORD=mot_de_passe_securise
DB_HOST=db
DB_PORT=5432

# ----- Sécurité HTTPS -----
# Activer uniquement si HTTPS est configuré
SECURE_SSL_REDIRECT=False

# ----- Redis (optionnel) -----
# Décommenter pour activer le cache Redis
# REDIS_URL=redis://redis:6379/0

# ----- Email (optionnel) -----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=contact@ecole.bf
# EMAIL_HOST_PASSWORD=mot_de_passe_email
